<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.gc.bz3x.huadb" android:versionCode="140" android:versionName="1.4.0">
  <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="30"/>
