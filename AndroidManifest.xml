    <package android:name="com.gxa.car.timesync"/>
    <package android:name="ru.artconcepts.bz3x.clock"/>
    <package android:name="com.gxa.firewall"/>
  </queries>
  <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
